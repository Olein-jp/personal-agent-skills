{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "オレイン記事監査結果 v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rules_version",
    "mode",
    "created_at",
    "subject",
    "evidence",
    "datasets",
    "summaries",
    "findings",
    "plan",
    "revisions",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "rules_version": {
      "const": "1.0"
    },
    "mode": {
      "enum": [
        "PLAN",
        "AUDIT",
        "REVISE"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "version",
        "audience",
        "goal",
        "content_type",
        "determination",
        "type_reason",
        "scope"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "content_type": {
          "enum": [
            "集客・相談型",
            "技術解説型",
            "比較・意思決定型",
            "その他",
            "不明"
          ]
        },
        "determination": {
          "enum": [
            "explicit",
            "inferred",
            "unknown"
          ]
        },
        "type_reason": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 1
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "status",
          "evidence_id",
          "acquired_at",
          "period",
          "scope",
          "timezone",
          "definitions",
          "limitations"
        ],
        "properties": {
          "kind": {
            "enum": [
              "search_console",
              "ga4",
              "inquiries"
            ]
          },
          "status": {
            "enum": [
              "available",
              "partial",
              "missing"
            ]
          },
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "acquired_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "period": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "start",
                  "end"
                ],
                "properties": {
                  "start": {
                    "type": "string",
                    "format": "date"
                  },
                  "end": {
                    "type": "string",
                    "format": "date"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "timezone": {
            "type": [
              "string",
              "null"
            ]
          },
          "definitions": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "available"
                }
              }
            },
            "then": {
              "properties": {
                "acquired_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "period": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "start",
                    "end"
                  ],
                  "properties": {
                    "start": {
                      "type": "string",
                      "format": "date"
                    },
                    "end": {
                      "type": "string",
                      "format": "date"
                    }
                  }
                },
                "timezone": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "missing"
                }
              }
            },
            "then": {
              "properties": {
                "acquired_at": {
                  "type": "null"
                },
                "period": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "minItems": 0
    },
    "summaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "status",
          "reason",
          "limitations"
        ],
        "properties": {
          "domain": {
            "enum": [
              "seo_content",
              "conversion",
              "reader_trust"
            ]
          },
          "status": {
            "enum": [
              "適切",
              "改善推奨",
              "要確認",
              "判定不可",
              "評価対象外"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        }
      },
      "minItems": 3,
      "maxItems": 3
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      },
      "minItems": 18,
      "maxItems": 18
    },
    "plan": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "search_intent",
            "required_information",
            "decision_information",
            "consultation_value",
            "outline",
            "cta_policy",
            "missing_research",
            "hypotheses"
          ],
          "properties": {
            "search_intent": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "required_information": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "decision_information": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "consultation_value": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "outline": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "cta_policy": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "missing_research": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "hypotheses": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_ids",
          "location",
          "before",
          "after",
          "reason"
        ],
        "properties": {
          "finding_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "before": {
            "type": "string"
          },
          "after": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_type",
        "title",
        "publisher",
        "source",
        "availability",
        "checked_at",
        "published_date",
        "updated_date",
        "location",
        "observation",
        "supports",
        "limitations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^EV-[A-Za-z0-9-]+$"
        },
        "source_type": {
          "enum": [
            "article",
            "plan",
            "official",
            "service",
            "analytics",
            "business",
            "supplementary"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "availability": {
          "enum": [
            "available",
            "unavailable",
            "not_provided"
          ]
        },
        "checked_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "published_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "updated_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "observation": {
          "type": "string",
          "minLength": 1
        },
        "supports": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": {
                "const": "not_provided"
              }
            }
          },
          "then": {
            "properties": {
              "checked_at": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "checked_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "classification",
        "status",
        "severity",
        "confidence",
        "finding",
        "rationale",
        "evidence",
        "limitations",
        "recommendation",
        "priority",
        "priority_reason",
        "expected_effect",
        "validation"
      ],
      "properties": {
        "id": {
          "enum": [
            "A-01",
            "A-02",
            "B-01",
            "B-02",
            "B-03",
            "B-04",
            "B-05",
            "C-01",
            "C-02",
            "C-03",
            "D-01",
            "D-02",
            "E-01",
            "E-02",
            "E-03",
            "E-04",
            "F-01",
            "F-02"
          ]
        },
        "category": {
          "enum": [
            "consultation_value",
            "conversion_path",
            "reader_trust",
            "search_intent",
            "seo_quality",
            "service_fit"
          ]
        },
        "classification": {
          "enum": [
            "FACT",
            "EVALUATION",
            "HYPOTHESIS",
            "UNVERIFIED"
          ]
        },
        "status": {
          "enum": [
            "適切",
            "改善推奨",
            "要確認",
            "判定不可",
            "評価対象外"
          ]
        },
        "severity": {
          "enum": [
            "critical",
            "improvement",
            "info",
            "none"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "finding": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence_id",
              "location",
              "observation"
            ],
            "properties": {
              "evidence_id": {
                "type": "string",
                "minLength": 1
              },
              "location": {
                "type": "string",
                "minLength": 1
              },
              "observation": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 0
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "recommendation": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "enum": [
            "P1",
            "P2",
            "P3",
            "none"
          ]
        },
        "priority_reason": {
          "type": "string",
          "minLength": 1
        },
        "expected_effect": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "description",
            "evidence_ids"
          ],
          "properties": {
            "status": {
              "enum": [
                "unverified",
                "observed",
                "not_applicable"
              ]
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metric",
            "method",
            "success_condition",
            "confounders"
          ],
          "properties": {
            "metric": {
              "type": "string",
              "minLength": 1
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "success_condition": {
              "type": "string",
              "minLength": 1
            },
            "confounders": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "判定不可"
              }
            }
          },
          "then": {
            "properties": {
              "classification": {
                "const": "UNVERIFIED"
              },
              "confidence": {
                "const": "unknown"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "UNVERIFIED"
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "enum": [
                  "判定不可",
                  "要確認"
                ]
              },
              "confidence": {
                "const": "unknown"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "HYPOTHESIS"
              }
            }
          },
          "then": {
            "properties": {
              "expected_effect": {
                "properties": {
                  "status": {
                    "const": "unverified"
                  }
                }
              },
              "evidence": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "改善推奨"
              }
            }
          },
          "then": {
            "properties": {
              "severity": {
                "enum": [
                  "critical",
                  "improvement"
                ]
              },
              "priority": {
                "enum": [
                  "P1",
                  "P2",
                  "P3"
                ]
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "PLAN"
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "search_intent",
              "required_information",
              "decision_information",
              "consultation_value",
              "outline",
              "cta_policy",
              "missing_research",
              "hypotheses"
            ],
            "properties": {
              "search_intent": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "required_information": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "decision_information": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "consultation_value": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "outline": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "cta_policy": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "missing_research": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "hypotheses": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            }
          },
          "revisions": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "plan": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "AUDIT"
          }
        }
      },
      "then": {
        "properties": {
          "revisions": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "REVISE"
          }
        }
      },
      "then": {
        "properties": {
          "revisions": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
